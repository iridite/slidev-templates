{
  "name": "slidev-templates",
  "version": "1.1.0",
  "private": true,
  "description": "Curated registry and community ecosystem for reusable Slidev presentation templates",
  "workspaces": [
    "neko-style/theme",
    "neko-style/starter"
  ],
  "bin": {
    "slidev-templates": "./scripts/registry-cli.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "templates": "node scripts/registry-cli.mjs",
    "build:hosted": "node scripts/build-hosted-templates.mjs",
    "gallery:serve": "node scripts/serve-gallery.mjs",
    "verify:ecosystem": "npm test && npm run build:hosted",
    "dev:neko": "npm run dev -w neko-style/starter",
    "build:neko": "npm run build -w neko-style/starter",
    "export:neko": "npm run export -w neko-style/starter"
  },
  "keywords": [
    "slidev",
    "slidev-template",
    "template",
    "presentation",
    "registry",
    "starter",
    "gallery"
  ],
  "license": "MIT"
}
