{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iridite/slidev-templates/blob/main/registry/hosted-template.schema.json",
  "title": "Hosted Slidev Template Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "categories",
    "tags",
    "license",
    "licenseUrl",
    "provenance",
    "compatibility",
    "verification",
    "entry",
    "commands"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 60
    },
    "categories": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "license": {
      "type": "string",
      "minLength": 2
    },
    "licenseUrl": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "notes"
      ],
      "properties": {
        "type": {
          "enum": [
            "original",
            "inspired",
            "adapted"
          ]
        },
        "upstream": {
          "type": "string",
          "format": "uri"
        },
        "notes": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "slidev"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "slidev": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "checks",
        "workflow"
      ],
      "properties": {
        "level": {
          "enum": [
            "build-and-export",
            "clean-install-build"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^starter/"
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "build",
        "export"
      ],
      "properties": {
        "dev": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "export": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
