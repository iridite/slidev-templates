{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iridite/slidev-templates/blob/main/registry/hosted-template.schema.json",
  "title": "Hosted Slidev Template Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "categories",
    "tags",
    "license",
    "provenance",
    "compatibility",
    "entry",
    "commands"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 2 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string", "minLength": 30 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "license": { "type": "string", "minLength": 2 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "notes"],
      "properties": {
        "type": { "enum": ["original", "inspired", "adapted"] },
        "upstream": { "type": "string", "format": "uri" },
        "notes": { "type": "string", "minLength": 20 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "slidev"],
      "properties": {
        "node": { "type": "string" },
        "slidev": { "type": "string" }
      }
    },
    "entry": { "type": "string", "pattern": "^starter/" },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "build", "export"],
      "properties": {
        "dev": { "type": "string" },
        "build": { "type": "string" },
        "export": { "type": "string" }
      }
    }
  }
}
